<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121417">
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O-Pilot"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Init..."
        android:textColor="#9AA4B2"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />
    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:background="#1C2026"
        android:layout_marginBottom="12dp" />
    <Button
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Далее: поиск КП и севера (OpenCV)"
        android:visibility="gone"
        android:layout_marginBottom="10dp" />
    <Button
        android:id="@+id/btnScanCamera"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Сканировать карту (камера)"
        android:layout_marginBottom="8dp" />
    <Button
        android:id="@+id/btnPickGallery"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Загрузить фото из галереи"
        android:layout_marginBottom="8dp" />
    <Button
        android:id="@+id/btnImportPdf"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Импорт карты из PDF" />
</LinearLayout>
